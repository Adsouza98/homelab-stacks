{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "enabledManagers": [
    "docker-compose",
    "github-actions"
  ],
  "packageRules": [
    {
      "description": "LinuxServer images use ls### build tags on lscr.io",
      "matchPackageNames": ["/^lscr\\.io\\/linuxserver\\//"],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?-ls(?<revision>\\d+)$",
      "dockerMaxPages": 100
    },
    {
      "matchDatasources": ["docker"],
      "groupName": "Docker images",
      "groupSlug": "docker-images",
      "schedule": ["every weekend"],
      "minimumReleaseAge": "3 days"
    },
    {
      "groupName": "VPN (gluetun)",
      "groupSlug": "vpn-gluetun",
      "schedule": ["at 3am on Monday"],
      "automerge": false,
      "labels": ["vpn", "critical"],
      "matchPackageNames": [
        "/gluetun/"
      ]
    },
    {
      "groupName": "Arr Stack - Downloaders",
      "groupSlug": "arr-downloaders",
      "matchPackageNames": [
        "/prowlarr|radarr|sonarr|bazarr|sabnzbd|deluge/"
      ]
    },
    {
      "groupName": "Arr Stack - Management",
      "groupSlug": "arr-management",
      "matchPackageNames": [
        "/tautulli|kometa/"
      ]
    },
    {
      "groupName": "Utility Services",
      "groupSlug": "utility-services",
      "matchPackageNames": [
        "/flaresolverr/"
      ]
    },
    {
      "groupName": "Website Stack",
      "groupSlug": "website-stack",
      "matchPackageNames": [
        "/organizr|ombi|nginx-proxy-manager|mariadb/"
      ]
    },
    {
      "groupName": "Misc Stack",
      "groupSlug": "misc-stack",
      "matchPackageNames": [
        "/muse|scrutiny|threadfin/"
      ]
    }
  ],
  "automerge": false,
  "prConcurrentLimit": 5,
  "semanticCommits": "enabled",
  "commitMessagePrefix": "chore(deps):",
  "vulnerabilityAlerts": {
    "labels": ["security", "renovate"]
  }
}